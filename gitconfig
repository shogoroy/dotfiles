[include]
	path = ~/.gitconfig.local
[core]
	editor = nvim
[log]
	decorate = short
[url "git@github.com:"]
	pushInsteadOf = https://github.com
	insteadOf = https://github.com
[pull]
	rebase = false
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[phantom]
	# worktree をリポジトリ root 直下の ./.worktrees/<name> に作る (default は .git/phantom/worktrees)
	worktreesDirectory = .worktrees
